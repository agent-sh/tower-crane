{
  "name": "@agent-sh/tower-crane",
  "version": "0.1.7",
  "description": "Plan, dispatch, review and merge agent work from one issue to a whole project, with state in plain files and gates in software",
  "license": "MIT",
  "author": { "name": "Avi Fenesh", "url": "https://github.com/avifenesh" },
  "repository": { "type": "git", "url": "git+https://github.com/agent-sh/tower-crane.git" },
  "homepage": "https://github.com/agent-sh/tower-crane#readme",
  "bugs": { "url": "https://github.com/agent-sh/tower-crane/issues" },
  "keywords": ["agents", "orchestration", "coding-agents", "code-review", "ci", "cli", "worktrees"],
  "bin": { "tower-crane": "bin/tower-crane.js" },
  "engines": { "node": ">=24" },
  "publishConfig": { "access": "public" },
  "files": ["bin/", "lib/", "hooks/", "skills/", "agents/", "commands/", "standards/", "docs/state.md", "docs/state/", "docs/cli.md", "docs/ladder.md", "docs/automation.md", "docs/design.md", "docs/builtin-ladder.json", "CHANGELOG.md", ".claude-plugin/", ".mcp.json", "components.json"],
  "scripts": {
    "test": "node test/run.js --test-concurrency=4",
    "docs:generate": "node scripts/cli-docs.js",
    "docs:cli": "node scripts/cli-docs.js",
    "docs:cli:check": "node scripts/cli-docs.js --check",
    "docs:links": "node scripts/doc-links.js",
    "check:shared": "node scripts/check-shared-files.js --mutants",
    "changelog": "node scripts/changelog.js"
  },
  "tower-crane": {
    "generated": {
      "docs/cli.md": {
        "script": "docs:generate",
        "blocks": ["commands:Plan", "commands:Stack", "commands:Run", "commands:Decisions", "commands:Views", "commands:Agents and worktrees", "commands:Gates"]
      }
    }
  }
}
